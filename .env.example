# .env.example — wapp-cloud-platform (dev)
#
# Plantilla versionada (patrón EduGo). Copia a `.env` y ajusta; `.env` está en .gitignore.
# El binario NO lee este archivo por sí solo: cárgalo en la shell antes de arrancar:
#     set -a; . ./.env; set +a
#     go run ./cmd/server serve
# Todo aquí es override de los defaults de internal/platform/config (prefijo WAPP_).
#
# ─── Puertos: BANDA wApp 81xx (aparte de EduGo 80xx) ──────────────────────────
# Ver docs/CONVENCIONES.md → "Rango de puertos por ecosistema".
#   8100  HTTP health/admin (/healthz, /admin/leases/revoke)
#   8101  gRPC CloudLink (mTLS estricto, stream bidi)
#   8102  gRPC Enrollment (TLS de servidor; el Edge enrola antes de tener cert)
#   8103  HTTP API pública /api/v1 (terceros; Plan 018, listener aparte del admin)
WAPP_HTTP_ADDR=:8100
WAPP_GRPC_CONNECT_ADDR=:8101
WAPP_GRPC_ENROLL_ADDR=:8102
WAPP_PUBLIC_HTTP_ADDR=:8103

# ─── Context Token de wApp (Plan 028/ADR-0019) ────────────────────────────────
# `iss` que wApp estampa y valida en SUS tokens. No confundir con el de
# identity-core: wApp ya no emite identidad, emite CONTEXTO de negocio (el tenant
# y los grants) a cambio de un Identity Token del SSO.
#
# WAPP_JWT_SECRET y WAPP_SERVICE_JWT_AUDIENCE se retiraron con el plano M2M
# (identity Plan 003 · Ola 5): eran el último rincón donde wApp firmaba en HS256,
# y nadie tenía credencial de máquina. Si aparecen en tu `.env`, bórralas: ya no
# se leen.
WAPP_JWT_ISSUER=wapp-cloud
# Clave privada EC P-256 que firma los Context Tokens en ES256 (ADR-0019, Plan
# 028): el ÚNICO emisor que le queda a wApp. Acepta PKCS#8 y SEC1. En prod
# (WAPP_APP_ENV=prod) es OBLIGATORIA y el arranque falla si falta, si los permisos
# son más laxos que 0600 o si la clave es inválida; en dev, si queda vacía se genera
# un par efímero con warning (los tokens no sobreviven a un reinicio). Genérala y
# protégela con:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out jwt-es256.pem && chmod 600 jwt-es256.pem
WAPP_JWT_EC_PRIVATE_KEY_FILE=<ruta-al-PEM-en-.env-NO-aqui>
# Key id (`kid`) activo que el emisor ES256 estampa y que el validador usa para
# seleccionar la pública. Convención es256-YYYYMMDD. Con ES256 como único emisor
# de usuario (T4) es OBLIGATORIO en prod (el arranque falla si falta); vacío en
# dev ⇒ "es256-dev".
WAPP_JWT_KID=es256-dev

# ─── Cifrado de PII en reposo: material de KEK (Plan 011/012 · ADR-0017) ──────
# OBLIGATORIO PARA ARRANCAR, también en dev. Sin él el servidor hace fail-fast con
#   fallo fatal del arranque: construyendo KeyProvider de PII (Plan 011):
#   falta material de KEK: define WAPP_KEK_KEYRING+WAPP_KEK_CURRENT o WAPP_KEK_MASTER_B64
# Copiar este ejemplo a `.env` SIN rellenar estas claves deja el arranque muerto en
# el primer intento: no es opcional como el resto de los defaults de dev.
#
# Camino simple (dev): una KEK maestra única de 32 B en base64.
#   openssl rand -base64 32
# Camino versionado (Plan 012, rotación sin re-cifrar): WAPP_KEK_KEYRING con
# entradas "id:base64" y WAPP_KEK_CURRENT con el id de la current. Si defines el
# keyring, la maestra sobra.
#
# NUNCA escribas aquí un valor real: los secretos viven SOLO en `.env`.
WAPP_KEK_MASTER_B64=<32B-base64: openssl rand -base64 32>
# WAPP_KEK_KEYRING=
# WAPP_KEK_CURRENT=
# indexKey del índice ciego HMAC, INDEPENDIENTE de la KEK y estable de por vida
# (cambiarla obliga a reindexar value_bidx, que es PK). OBLIGATORIA en prod; en dev,
# si queda vacía se deriva de la KEK por HKDF-SHA256 con warning.
WAPP_KEK_INDEX_B64=<32B-base64: openssl rand -base64 32>

# ─── identity-core: verificación de Identity Tokens (identity Plan 003 · Ola 1) ─
# INTERRUPTOR del modo dual. Endpoint JWKS de identity-api del que cloud-platform
# toma las claves públicas ES256 con las que verificar los Identity Tokens del SSO
# del grupo. Son DOS verificadores por TIPO de token: este mira los de identity, y
# el de arriba (WAPP_JWT_*) sigue mirando los Context Tokens que emite wApp.
# VACÍA (default) ⇒ modo dual APAGADO: wApp arranca sin identity, como hasta ahora.
# CON VALOR ⇒ el verificador se construye en el ARRANQUE y es fail-closed: si
# identity-api no responde, cloud-platform NO ARRANCA (comportamiento querido:
# quien define la variable declara que identity debe estar ahí). Fuera de loopback
# se exige https.
# Desde la Ola 3 tiene consumidor: es la que habilita POST /api/v1/auth/exchange
# (el canje de Identity Token por Context Token). Vacía ⇒ ese endpoint responde 503.
#   dev: http://localhost:8200/.well-known/jwks.json
WAPP_IDENTITY_JWKS_URL=

# SEGUNDO INTERRUPTOR (identity Plan 003 · Ola 3, T3.3): base de identity-api con
# la que el gateway CloudLink DELEGA el login/refresh/logout del operador del Edge.
# Son ejes distintos de la misma transición: la de arriba enseña a wApp a VERIFICAR
# lo que identity firma; esta le dice a quién PREGUNTAR por las credenciales.
# VACÍA (default) ⇒ el relé sigue resolviendo credenciales con el IAM local: el
# flujo legacy queda INTACTO.
# CON VALOR ⇒ el relé autentica contra identity (system wapp.edge) y canjea la
# identidad por un Context Token. Exige WAPP_IDENTITY_JWKS_URL: sin verificador no
# hay canje, y esa combinación NO ARRANCA (fallar aquí es mejor que fallar en el
# primer login de un operador). El Edge no se entera y no cambia (REQ-A4).
#   dev: http://localhost:8200
WAPP_IDENTITY_URL=
# Tope de cada llamada a identity-api. Default 10s; <=0 cae al default. Es corto a
# propósito: estas llamadas están en el camino de un login, y un identity lento
# tiene que degradar en un error, no en una espera indefinida del operador.
WAPP_IDENTITY_TIMEOUT=

# ─── Rate-limit de la API pública (Plan 018 · T10, R11) ───────────────────────
# Token-bucket EN MEMORIA (sin broker). PUBLIC_* acota cada credencial (el Bearer;
# sin credencial, la IP) en las rutas /api/v1 de operación. Al exceder: 429 con
# Retry-After. Defaults sanos; sube en despliegues de alto tráfico.
#
# WAPP_RATELIMIT_LOGIN_PER_MIN y _BURST se retiraron con el login (identity Plan
# 003 · Ola 5): la fuerza bruta de contraseñas se frena donde se validan, y eso
# es identity-core.
WAPP_RATELIMIT_PUBLIC_RPS=20
WAPP_RATELIMIT_PUBLIC_BURST=40

# ─── Postgres: contenedor COMPARTIDO con EduGo (edugo-postgres, localhost:5432) ─
# wApp NO levanta contenedor propio: reutiliza la instancia de EduGo con su
# PROPIA base y rol (créalos con deploy/bootstrap-shared-db.sql). Ver deploy/README.md.
WAPP_DB_HOST=localhost
WAPP_DB_PORT=5432
WAPP_DB_USER=wapp
WAPP_DB_PASSWORD=wapp
WAPP_DB_NAME=wapp_cloud
WAPP_DB_SSLMODE=disable

# ─── Entorno / logging ────────────────────────────────────────────────────────
WAPP_APP_ENV=dev
WAPP_LOG_LEVEL=info
WAPP_LOG_JSON=false

# ─── Almacén de objetos: Cloudflare R2 (S3-compatible; NO AWS, sin costo) ─────
# Plan 017 (PDF/Media). REUTILIZA la cuenta/bucket de EduGo (alpha): mismos valores
# que edugo-api-learning/.env-cloud. Los valores REALES (endpoint con account-id,
# access key y secret) van SOLO en `.env` (NO versionado); aquí van los nombres.
# R2 free permite varios buckets; por ahora reusamos `edugo-materials` con un
# PREFIJO propio de wApp para aislar sin crear nada nuevo. Cambiar a bucket propio
# `wapp-media` es solo cambiar WAPP_STORAGE_S3_BUCKET (configurable).
WAPP_STORAGE_S3_REGION=us-east-1
WAPP_STORAGE_S3_BUCKET=edugo-materials
WAPP_STORAGE_S3_PREFIX=wapp/
WAPP_STORAGE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
WAPP_STORAGE_S3_ACCESS_KEY_ID=<usa-el-de-edugo-api-learning/.env-cloud>
WAPP_STORAGE_S3_SECRET_ACCESS_KEY=<usa-el-de-edugo-api-learning/.env-cloud>
WAPP_STORAGE_S3_PRESIGN_EXPIRY=15m

# ─── PKI de dev (genera con scripts/gen-dev-certs.sh) ─────────────────────────
# WAPP_PKI_SERVER_CERT_FILE=certs/server.crt
# WAPP_PKI_SERVER_KEY_FILE=certs/server.key
# WAPP_PKI_CA_CERT_FILE=certs/ca.crt
# WAPP_PKI_CA_KEY_FILE=certs/ca.key
